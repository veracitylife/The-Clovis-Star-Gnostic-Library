{
  "name": "clovisstar-static",
  "version": "1.1.18",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "node scripts/ingest-books.js",
    "crawl:front": "node scripts/crawl-front-facing.js",
    "ingest:front": "node scripts/import-front-facing-export.js",
    "db:init": "node scripts/init-mysql.js",
    "db:init:library": "node scripts/init-library-mysql.js",
    "db:init:postgres": "node scripts/init-postgres.js",
    "db:maintain": "node scripts/maintain-database.js",
    "db:optimize": "node scripts/maintain-database.js --optimize",
    "media:optimize": "node scripts/optimize-media-assets.js",
    "version:bump": "node scripts/bump-site-version.js",
    "db:migrate:research": "node scripts/migrate-research-tools.js",
    "db:migrate-json": "node scripts/migrate-json-to-mysql.js",
    "admin:promote": "node scripts/promote-admin.js",
    "normalize:corpus": "node scripts/normalize-live-corpus.js",
    "normalize:corpus:check": "node scripts/normalize-live-corpus.js --check",
    "content:quarantine-incomplete": "node scripts/quarantine-incomplete-public-books.js",
    "content:quarantine-incomplete:check": "node scripts/quarantine-incomplete-public-books.js --check",
    "content:fix-remaining": "node scripts/fix-remaining-content-issues.js",
    "content:fix-remaining:check": "node scripts/fix-remaining-content-issues.js --check",
    "audit:content": "node scripts/run-content-integrity-audit.js",
    "audit:content:check": "node scripts/run-content-integrity-audit.js --check",
    "qa:nightly": "node scripts/nightly-qa-report.js",
    "qa:screenshots": "node scripts/browser-screenshot-qa.js",
    "monitor:health": "node scripts/monitor-health.js",
    "serve": "node server.js",
    "prod:start": "sh scripts/start-production.sh",
    "prod:stop": "sh scripts/stop-production.sh",
    "prod:status": "sh scripts/status-production.sh",
    "prod:install-service": "sh scripts/install-user-service.sh",
    "prod:install-schedules": "sh scripts/install-production-schedules.sh",
    "logs:maintain": "node scripts/log-maintenance.js",
    "serve:static": "npx --yes serve . -l 4173",
    "test": "node tests/run-tests.mjs",
    "test:architecture": "node tests/architecture-smoke.mjs",
    "smoke:live": "node tests/live-smoke.mjs",
    "health": "node scripts/health-check.js",
    "verify": "node --check server.js && node --check assets/js/app.js && npm run audit:content:check && npm run test && npm run test:architecture && node scripts/health-check.js"
  },
  "dependencies": {
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "playwright-chromium": "^1.61.0",
    "serve": "^14.2.4"
  }
}

