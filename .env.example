NODE_ENV=production
CLOVIS_STORAGE=mysql
CLOVIS_DB_HOST=clovisstar.com
CLOVIS_DB_NAME=clovisstar_script101ab
CLOVIS_DB_USER=clovisstar_92scripts101
CLOVIS_DB_PASSWORD=REPLACE_WITH_SECRET_VALUE
CLOVIS_ADMIN_EMAILS=
CLOVIS_SESSION_COOKIE=clovisstar_session
CLOVIS_CSRF_COOKIE=clovisstar_csrf
CLOVIS_SESSION_TTL_HOURS=720
PORT=4173

DATABASE_URL=

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/var/www/clovisstar/storage/uploads
PUBLIC_FILE_BASE_URL=https://clovisstar.com/uploads
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp,audio/mpeg,audio/wav,video/mp4

SEARCH_DRIVER=postgres
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=clovisstar_content

VECTOR_SEARCH_ENABLED=false
VECTOR_DRIVER=pgvector
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=redis

